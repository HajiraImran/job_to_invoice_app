{
  "name": "@job-to-invoice/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types --watch src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --config ../../eslint.config.js",
    "test": "vitest run --config vitest.config.ts",
    "db:latency": "node --experimental-transform-types src/db-latency.ts"
  },
  "dependencies": {
    "@job-to-invoice/config": "workspace:*",
    "@job-to-invoice/domain": "workspace:*",
    "@job-to-invoice/schemas": "workspace:*",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "pg": "8.16.3",
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/s3-request-presigner": "3.1132.0"
  },
  "devDependencies": {
    "@job-to-invoice/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}

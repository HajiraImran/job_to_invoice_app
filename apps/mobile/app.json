{
  "expo": {
    "name": "Job to Invoice",
    "slug": "job-to-invoice",
    "owner": "hajiraimran",
    "scheme": "jobtoinvoice",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jobtoinvoice.app"
    },
    "android": {
      "package": "com.jobtoinvoice.app"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [

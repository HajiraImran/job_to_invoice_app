        {
          "useSQLCipher": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "3fc325ae-6017-4dbc-84bb-2f28b44eb032"
      }
    }
  }
}

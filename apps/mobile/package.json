{
  "name": "@job-to-invoice/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:go": "expo start --go",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint app src --config ../../eslint.config.js",
    "test": "vitest run --config vitest.config.ts",
    "build": "node -e \"console.log('EAS profiles are configured; production credentials are not in this repository')\""
  },
  "dependencies": {
    "@job-to-invoice/domain": "workspace:*",
    "@job-to-invoice/schemas": "workspace:*",
    "@supabase/supabase-js": "2.116.0",
    "expo": "57.0.22",
    "expo-constants": "57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Job to Invoice API",
    "version": "0.1.0",
    "description": "Owner authentication, workspace setup, and workspace-isolated draft jobs."
  },
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Process health",
        "responses": {
          "200": {
            "description": "API process is running"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "summary": "Owner bootstrap",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Verified identity, workspace version, and setup state" },
          "401": { "description": "Missing or invalid access token" },
          "503": { "description": "Database, role, or provisioning unavailable" }
        }
      }
    },
    "/v1/analytics/batch": {
      "post": {
        "summary": "Client analytics batch",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["events"],
                "properties": {
                  "events": { "type": "array", "minItems": 1, "maxItems": 50 }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Accepted" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended or locked account" },
          "422": { "description": "Validation failed" }
        }
      }
    },
    "/v1/workspace": {
      "post": {
        "summary": "Complete owner business setup on the provisioned workspace",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Current workspace version from GET /v1/me"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "business_name",
                  "legal_name",
                  "contact_name",
                  "contact_email",
                  "address",
                  "timezone",
                  "timezone_confirmed",
                  "trade",
                  "default_tax_bp",
                  "default_due_days",
                  "skip_logo"
                ],
                "properties": {
                  "business_name": { "type": "string" },
                  "legal_name": { "type": "string" },
                  "contact_name": { "type": "string" },
                  "contact_email": { "type": "string" },
                  "contact_phone": { "type": ["string", "null"] },
                  "address": { "type": "object", "additionalProperties": false },
                  "timezone": { "type": "string" },
                  "timezone_confirmed": { "type": "boolean" },
                  "trade": { "type": "string", "enum": ["handyman", "other"] },
                  "default_tax_bp": { "type": "integer", "minimum": 0, "maximum": 2500 },
                  "tax_zero_confirmed": { "type": "boolean" },
                  "default_due_days": { "type": "integer", "minimum": 0, "maximum": 365 },
                  "default_terms": { "type": "string" },
                  "skip_logo": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Setup completed; authoritative bootstrap" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended or locked account" },
          "409": { "description": "Stale version or idempotency mismatch" },
          "422": { "description": "Validation failed" }
        }
      }
    },
    "/v1/jobs": {
      "get": {
        "summary": "List jobs in the caller's workspace",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "maxLength": 120 }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["open", "finished", "archived"], "default": "open" },
            "description": "S05 Active maps to open (draft, active, invoiced, canceled)."
          }
        ],
        "responses": {
          "200": { "description": "Cursor page of jobs: items and next_cursor" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, or setup incomplete" },
          "422": { "description": "Validation failed" }
        }
      },
      "post": {
        "summary": "Create a draft job and the minimum customer row",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobCreate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Draft job created" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, or setup incomplete" },
          "409": { "description": "Idempotency mismatch" },
          "422": { "description": "Validation failed" }
        }
      }
    },
    "/v1/jobs/{jobId}": {
      "get": {
        "summary": "Read a job in the caller's workspace",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Job overview with optional current quote draft totals; no ledger" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, or setup incomplete" },
          "404": { "description": "Unknown or cross-tenant job" },
          "422": { "description": "Invalid job id" }
        }
      }
    },
    "/v1/jobs/{jobId}/quote": {
      "post": {
        "summary": "Create or return the current editing quote draft for a quote-mode job",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Editing quote draft with server-calculated totals" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, or setup incomplete" },
          "404": { "description": "Unknown or cross-tenant job" },
          "409": { "description": "Idempotency mismatch" },
          "422": { "description": "Direct-invoice job, extra body fields, or invalid job id" }
        }
      }
    },
    "/v1/drafts/{draftId}": {
      "get": {
        "summary": "Read an editing quote draft and server-calculated totals",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Quote draft payload and calculated totals" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, or setup incomplete" },
          "404": { "description": "Unknown or cross-tenant draft" },
          "422": { "description": "Invalid draft id" }
        }
      },
      "patch": {
        "summary": "Replace the full editing quote draft payload",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Current draft version integer"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuoteDraftPayload" }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated draft with server-calculated totals" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, or setup incomplete" },
          "404": { "description": "Unknown or cross-tenant draft" },
          "409": { "description": "Version conflict or idempotency mismatch" },
          "422": { "description": "Validation failed" }
        }
      }
    },
    "/v1/drafts/{draftId}/preview": {
      "post": {
        "summary": "Freeze a 10-minute quote preview and return preview_hash",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Current draft version integer"
          }
        ],
        "responses": {
          "200": { "description": "Frozen quote preview with preview_hash; official number is not allocated" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, or setup incomplete" },
          "404": { "description": "Unknown or cross-tenant draft" },
          "409": { "description": "Version conflict" },
          "422": { "description": "Empty or invalid draft" }
        }
      }
    },
    "/v1/drafts/{draftId}/publish": {
      "post": {
        "summary": "Publish the current quote draft as an immutable revision",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Current draft version integer"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuotePublish" }
            }
          }
        },
        "responses": {
          "202": { "description": "Published quote; original PDF queued" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, setup incomplete, or entitlement required" },
          "404": { "description": "Unknown or cross-tenant draft" },
          "409": { "description": "Preview changed, version conflict, already published, or idempotency mismatch" },
          "422": { "description": "Validation failed" }
        }
      }
    },
    "/v1/documents/{documentId}": {
      "get": {
        "summary": "Read an immutable published quote snapshot and live PDF status",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Published quote snapshot; PDF may still be preparing" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, or setup incomplete" },
          "404": { "description": "Unknown or cross-tenant document" },
          "422": { "description": "Invalid document id" }
        }
      }
    },
    "/v1/documents/{documentId}/download": {
      "get": {
        "summary": "Original PDF artifact state; preparing until the worker finishes",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Artifact state preparing, ready, or failed; URL is null while preparing" },
          "401": { "description": "Missing or invalid access token" },
          "403": { "description": "Suspended, locked, or setup incomplete" },
          "404": { "description": "Unknown or cross-tenant document" },
          "422": { "description": "Invalid document id" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "JobCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "customer_name", "title", "no_site", "mode"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "customer_name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "no_site": { "type": "boolean" },
          "site_address": { "type": ["object", "null"], "additionalProperties": false },
          "internal_notes": { "type": ["string", "null"], "maxLength": 4000 },
          "mode": { "type": "string", "enum": ["quote", "direct_invoice"] }
        }
      },
      "QuoteDraftPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lines"],
        "properties": {
          "notes": { "type": "string", "maxLength": 2000 },
          "terms": { "type": "string", "maxLength": 4000 },
          "expiry_days": { "type": "integer", "minimum": 1, "maximum": 90 },
          "lines": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/QuoteDraftLine" }
          }
        }
      },
      "QuoteDraftLine": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_line_id", "description", "unit", "quantity", "unit_price_cents", "discount_cents", "tax_bp"],
        "properties": {
          "client_line_id": { "type": "string", "format": "uuid" },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "unit": { "type": "string", "enum": ["item", "hour", "day", "square_foot", "linear_foot", "custom"] },
          "custom_unit_label": { "type": ["string", "null"], "maxLength": 20 },
          "quantity": { "type": "string", "pattern": "^(0|[1-9]\\d{0,5})(\\.\\d{1,3})?$" },
          "unit_price_cents": { "type": "integer", "minimum": 0, "maximum": 99999999 },
          "discount_cents": { "type": "integer", "minimum": 0 },
          "tax_bp": { "type": "integer", "minimum": 0, "maximum": 2500 }
        }
      },
      "QuotePublish": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preview_hash"],
        "properties": {
          "preview_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
